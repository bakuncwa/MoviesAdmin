# Copy to .env (git-ignored) and fill in. This file is the single source of truth for local secrets:
#   - docker compose reads it automatically (SA password, host port)
#   - scripts/setup-secrets.sh copies it into the app's user secrets (connection string, seed admin,
#     movie lookup API keys), so the connection string always points at the same port compose opens.

# SQL Server container (SQL Server requires 8+ characters from 3 of: upper, lower, digit, symbol)
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=ChangeMe-Sql2026!

# Seeded admin account (created on first startup by Data/IdentitySeeder.cs).
# Password needs 6+ characters with an uppercase letter, a lowercase letter, and a digit.
SEED_ADMIN_EMAIL=admin@moviesadmin.local
SEED_ADMIN_PASSWORD=ChangeMe2026
SEED_ADMIN_DISPLAY_NAME=Administrator

# Optional: movie lookup sources for the Add/Edit form (leave blank to hide a source)
#   TMDB: https://www.themoviedb.org/settings/api (API key or read access token)
#   OMDb: https://www.omdbapi.com/apikey.aspx (IMDb data + Rotten Tomatoes/Metacritic scores)
TMDB_API_KEY=
OMDB_API_KEY=
