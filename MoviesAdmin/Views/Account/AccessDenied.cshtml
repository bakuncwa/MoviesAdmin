@{
    ViewData["Title"] = "Access denied";
}

<div class="auth-stage">
    <div class="auth-card text-center">
        <span class="brand-mark brand-mark-lg" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
        <h1 class="auth-title">Access denied</h1>
        <p class="auth-subtitle mb-4">Your account's role doesn't grant access to this page.</p>
        <a class="btn btn-glass" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>Back to dashboard</a>
    </div>
</div>
