@model MoviesAdmin.ViewModels.Movies.MovieCatalogViewModel
@using MoviesAdmin.ViewModels.Movies

@{
    ViewData["Title"] = "Movies";
    var query = Model.Query;
}

@* Sticky toolbar: search with "Add Movie" beside it, then filters and sort. The search/filter/sort
   controls form one GET form (#catalog-query) whose fields match MovieCatalogQuery, so it also
   works without JavaScript; movies.js submits it asynchronously to /Movies/Search instead. *@
<form id="catalog-query" class="catalog-toolbar" method="get" asp-action="Index" role="search">
    <label for="movie-search" class="visually-hidden">Search movies</label>
    <div class="search-pill">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="movie-search" name="q" value="@query.Q" placeholder="Search movies by title..." autocomplete="off" maxlength="200" />
    </div>
    @* Opens GET Movies/Create in the shared modal. *@
    <button type="button" class="btn btn-primary text-nowrap movie-create-btn">
        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add Movie
    </button>
    <div class="catalog-filters">
        <label for="filter-genre" class="visually-hidden">Genre</label>
        <select id="filter-genre" name="genreId" class="form-select form-select-sm toolbar-select">
            <option value="">All genres</option>
            @foreach (var genre in Model.GenreOptions)
            {
                <option value="@genre.Id" selected="@(query.GenreId == genre.Id)">@genre.Name</option>
            }
        </select>
        <label for="filter-year" class="visually-hidden">Release year</label>
        <select id="filter-year" name="year" class="form-select form-select-sm toolbar-select">
            <option value="">Any year</option>
            @foreach (var year in Model.YearOptions)
            {
                <option value="@year" selected="@(query.Year == year)">@year</option>
            }
        </select>
        <label for="filter-rating" class="visually-hidden">Content rating</label>
        <select id="filter-rating" name="rating" class="form-select form-select-sm toolbar-select">
            <option value="">Any rating</option>
            @foreach (var rating in Enum.GetValues<ContentRating>())
            {
                <option value="@rating" selected="@(query.Rating == rating)">@rating.ToLabel()</option>
            }
        </select>
        <label for="catalog-sort" class="visually-hidden">Sort by</label>
        <select id="catalog-sort" name="sort" class="form-select form-select-sm toolbar-select">
            @foreach (var (sort, label) in MovieCatalogQuery.SortOptions)
            {
                <option value="@sort" selected="@(query.Sort == sort)">@label</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-secondary">Apply</button></noscript>
    </div>
</form>

<section aria-labelledby="library-heading">
    <h2 id="library-heading" class="section-heading">Movies</h2>
    <div id="movie-catalog">
        <partial name="Partials/_Index" model="Model" />
    </div>
</section>

@* Shared modal shell for Create/Edit/View; its content is swapped in via AJAX by movies.js. *@
<div class="modal fade" id="movie-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="movie-modal-content">
            <!-- injected by wwwroot/js/movies.js -->
        </div>
    </div>
</div>

@* Antiforgery token source for the Delete fetch() call, which has no <form> of its own (Create/Edit
   forms carry their own token inside Partials/_Create.cshtml and Partials/_Edit.cshtml). *@
<form id="antiforgery-form" class="d-none">@Html.AntiForgeryToken()</form>

@section Styles {
    <link rel="stylesheet" href="~/lib/tom-select/dist/css/tom-select.bootstrap5.min.css" />
}

@section Scripts {
    @* Client-side validation for the Create/Edit form, which movies.js parses after loading it. *@
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/movies.js" asp-append-version="true"></script>
}
