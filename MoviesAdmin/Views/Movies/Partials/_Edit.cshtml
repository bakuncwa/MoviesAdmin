@model MoviesAdmin.ViewModels.Movies.MovieFormViewModel

@* GET Movies/Edit/5: injected into #movie-modal-content by wwwroot/js/movies.js, and posted back
   to POST Movies/Edit/5. The fields are shared with _Create via _Form. *@

<div class="modal-header">
    <h5 class="modal-title">Edit Movie</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form id="movie-form" action="@Url.Action("Edit", "Movies", new { id = Model.Id })" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PosterImagePath" />
    <partial name="Partials/_Form" model="Model" />
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save Changes</button>
    </div>
</form>
