@model MoviesAdmin.ViewModels.Movies.MovieFormViewModel

@* GET Movies/Create: injected into #movie-modal-content by wwwroot/js/movies.js, and posted back
   to POST Movies/Create. The fields are shared with _Edit via _Form. *@

<div class="modal-header">
    <h5 class="modal-title">Add Movie</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form id="movie-form" action="@Url.Action("Create", "Movies")" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <partial name="Partials/_Form" model="Model" />
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add Movie</button>
    </div>
</form>
