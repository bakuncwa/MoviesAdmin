@model List<MoviesAdmin.ViewModels.Movies.MovieListItemViewModel>

@* Rendered both by Movies/Index (initial page load) and Movies/Search (async search bar), so the
   client can swap #movie-table-body's innerHTML with the same markup either way. *@

@if (Model.Count == 0)
{
    <tr id="movie-empty-row">
        <td colspan="7" class="text-center text-body-secondary py-4">No movies found.</td>
    </tr>
}
else
{
    foreach (var movie in Model)
    {
        var runtimeText = movie.RuntimeMinutes.HasValue ? $"{movie.RuntimeMinutes} min" : "—";
        var genresText = string.IsNullOrEmpty(movie.GenreNames) ? "—" : movie.GenreNames;
        var releaseText = movie.ReleaseDate.ToString("MMM d, yyyy");

        <tr id="movie-row-@movie.Id" data-movie-id="@movie.Id">
            <td>
                <img src="@movie.DisplayImageUrl" alt="@movie.Title poster" class="rounded" style="width: 48px; height: 72px; object-fit: cover;" />
            </td>
            <td>@movie.Title</td>
            <td>@releaseText</td>
            <td>@runtimeText</td>
            <td>@genresText</td>
            <td>
                @if (movie.AverageRating.HasValue)
                {
                    @($"{movie.AverageRating:0.0} / 5 ({movie.ReviewCount})")
                }
                else
                {
                    <span class="text-body-secondary">No reviews</span>
                }
            </td>
            <td class="text-end">
                <div class="btn-group btn-group-sm" role="group" aria-label="Row actions">
                    <button type="button" class="btn btn-outline-secondary movie-view-btn" data-id="@movie.Id" title="View details">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i><span class="visually-hidden">View</span>
                    </button>
                    <button type="button" class="btn btn-outline-primary movie-edit-btn" data-id="@movie.Id" title="Edit movie">
                        <i class="fa-solid fa-pen" aria-hidden="true"></i><span class="visually-hidden">Edit</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger movie-delete-btn"
                            data-id="@movie.Id"
                            data-title="@movie.Title"
                            data-image="@movie.DisplayImageUrl"
                            data-release="@releaseText"
                            data-runtime="@runtimeText"
                            data-genres="@genresText"
                            title="Delete movie">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="visually-hidden">Delete</span>
                    </button>
                </div>
            </td>
        </tr>
    }
}
