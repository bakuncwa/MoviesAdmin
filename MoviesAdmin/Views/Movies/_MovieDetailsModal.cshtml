@model MoviesAdmin.ViewModels.Movies.MovieDetailsViewModel

@* Injected into #movie-modal-content by wwwroot/js/movies.js when a "View" button is clicked. *@

<div class="details-modal">
    <img class="details-backdrop" src="@Model.DisplayImageUrl" alt="" aria-hidden="true" />
    <button type="button" class="btn-close details-close" data-bs-dismiss="modal" aria-label="Close"></button>

    <div class="details-body">
        <div class="row g-4">
            <!-- Left: poster image, with a lazy-loaded trailer embed underneath -->
            <div class="col-md-4">
                <img src="@Model.DisplayImageUrl" alt="@Model.Title poster" class="details-poster" />

                @if (Model.HasTrailer)
                {
                    <div id="movie-trailer-slot" class="mt-3" data-trailer-url="@Url.Action("TrailerEmbed", "Movies", new { id = Model.Id })">
                        <button type="button" class="btn btn-primary w-100 movie-trailer-btn">
                            <i class="fa-solid fa-play me-1" aria-hidden="true"></i>Watch Trailer
                        </button>
                    </div>
                }
            </div>

            <!-- Right: movie details -->
            <div class="col-md-8">
                <h2 class="details-title">@Model.Title</h2>
                <div class="hero-meta mb-3">
                    @if (Model.AverageRating.HasValue)
                    {
                        var reviewWord = Model.ReviewCount == 1 ? "review" : "reviews";
                        <span class="rating-chip"><i class="fa-solid fa-star" aria-hidden="true"></i>@Model.AverageRating.Value.ToString("0.0")</span>
                        <span>@Model.ReviewCount @reviewWord</span>
                    }
                    <span class="rating-badge">@Model.ContentRatingLabel</span>
                    <span>@Model.ReleaseDate.ToString("MMMM d, yyyy")</span>
                    @if (Model.RuntimeMinutes.HasValue)
                    {
                        <span>@Model.RuntimeText</span>
                    }
                </div>

                @if (Model.GenreNames.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var genre in Model.GenreNames)
                        {
                            <span class="genre-pill">@genre</span>
                        }
                    </div>
                }

                <p class="details-synopsis">@(string.IsNullOrWhiteSpace(Model.Synopsis) ? "No synopsis yet." : Model.Synopsis)</p>

                <dl class="details-facts">
                    <div>
                        <dt>Director</dt>
                        <dd>@(Model.DirectorName ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Studio</dt>
                        <dd>@(Model.StudioName ?? "—")</dd>
                    </div>
                    @if (!Model.AverageRating.HasValue)
                    {
                        <div>
                            <dt>Rating</dt>
                            <dd>No reviews yet</dd>
                        </div>
                    }
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <button type="button" class="btn btn-glass movie-edit-btn" data-id="@Model.Id"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit</button>
                    <button type="button" class="btn btn-link text-body-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
