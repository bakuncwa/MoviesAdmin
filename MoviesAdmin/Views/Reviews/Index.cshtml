@model IEnumerable<MoviesAdmin.Models.Review>
@using MoviesAdmin.ViewModels.Movies

@{
    ViewData["Title"] = "My Reviews";
}

<h1>My Reviews</h1>

<partial name="_Message" />

<p>
    @* Reviews start from a movie's Review button, so this goes to the catalog to pick one. *@
    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Write a Review</a>
</p>

@if (!Model.Any())
{
    <div class="catalog-empty">
        <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
        <p class="mb-0">You haven't written any reviews yet.</p>
    </div>
}
else
{
    <div class="table-responsive catalog-list-view">
        <table class="table table-hover align-middle catalog-table mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 64px;">Poster</th>
                    <th scope="col">Movie</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last updated</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@MoviePosterResolver.Resolve(item.Movie)" alt="@item.Movie.Title poster" class="catalog-table-thumb" loading="lazy" />
                        </td>
                        <td class="catalog-title">@item.Movie.Title</td>
                        <td class="text-nowrap"><partial name="_Stars" model="item.Rating" /> <span class="ms-1">@item.Rating.ToString("0.#")</span></td>
                        <td><partial name="_StatusBadge" model="item" /></td>
                        <td>@((item.PublishedAt ?? item.UpdatedAt ?? item.CreatedAt).ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1" role="group" aria-label="Review actions">
                                @* View and Delete open as modals (wwwroot/js/my-reviews.js); the links
                                   still work without JavaScript. Edit is its own page. *@
                                <a class="btn btn-sm btn-outline-secondary review-view-btn" asp-action="Details" asp-route-id="@item.Id" data-id="@item.Id">
                                    <i class="fa-solid fa-eye me-1" aria-hidden="true"></i>View
                                </a>
                                @* Drafts only: requirement 7 locks a review once it's published. *@
                                @if (!item.IsPublished)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger review-delete-btn" asp-action="Delete" asp-route-id="@item.Id" data-id="@item.Id">
                                        <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Shared modal shell for View and Delete. TempData["OpenReview"] (set after saving, publishing, or
   opening a review's URL directly) names a review whose View modal opens on arrival. *@
<div class="modal fade" id="review-modal" tabindex="-1" aria-hidden="true" data-open-review="@TempData["OpenReview"]">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="review-modal-content">
            <!-- injected by wwwroot/js/my-reviews.js -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/my-reviews.js" asp-append-version="true"></script>
}
