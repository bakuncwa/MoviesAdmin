@model MoviesAdmin.Models.Review

@{
    ViewData["Title"] = "Delete Draft Review";
}

<h1>Delete Draft Review</h1>

<h3>Are you sure you want to delete this draft?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Movie</dt>
        <dd class="col-sm-10">@Model.Movie.Title</dd>

        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.Rating / 5</dd>

        <dt class="col-sm-2">Review</dt>
        <dd class="col-sm-10" style="white-space: pre-line;">@Model.Text</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to My Reviews</a>
    </form>
</div>
