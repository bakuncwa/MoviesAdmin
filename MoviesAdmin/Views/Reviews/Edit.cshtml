@model MoviesAdmin.ViewModels.Reviews.ReviewFormViewModel

@{
    ViewData["Title"] = "Edit Draft Review";
}

<h1>Edit Draft Review</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_ReviewForm" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
