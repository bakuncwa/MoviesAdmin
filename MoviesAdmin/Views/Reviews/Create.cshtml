@model MoviesAdmin.ViewModels.Reviews.ReviewFormViewModel

@{
    ViewData["Title"] = "Write a Review";
}

<a asp-controller="Movies" asp-action="Index" class="back-link"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to Movies</a>
<h1 class="page-title">Write a Review</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            <partial name="_ReviewForm" model="Model" />
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/quill/dist/quill.snow.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/quill/dist/quill.js"></script>
    <script src="~/js/reviews.js" asp-append-version="true"></script>
}
