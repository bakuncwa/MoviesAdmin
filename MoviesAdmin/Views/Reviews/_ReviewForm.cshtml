@model MoviesAdmin.ViewModels.Reviews.ReviewFormViewModel

@* Shared Create/Edit fields. Two submit buttons: "Save draft" keeps the review editable,
   "Publish" (name="submit" value="publish") locks it for good, so it asks for confirmation. *@

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="MovieId" class="form-label"></label>
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="MovieId" />
        <p class="form-control-plaintext fw-semibold">@Model.MovieTitle</p>
    }
    else
    {
        <select asp-for="MovieId" asp-items="ViewBag.MovieId" class="form-select">
            <option value="">Choose a movie...</option>
        </select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    }
</div>

<div class="mb-3">
    <label asp-for="Rating" class="form-label"></label>
    <select asp-for="Rating" class="form-select" style="max-width: 12rem;">
        <option value="">Choose...</option>
        @for (var stars = 5; stars >= 0; stars--)
        {
            <option value="@stars">@stars / 5</option>
        }
    </select>
    <span asp-validation-for="Rating" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Text" class="form-label"></label>
    <textarea asp-for="Text" class="form-control" rows="8" maxlength="1000" id="review-text"></textarea>
    <div class="d-flex justify-content-between">
        <span asp-validation-for="Text" class="text-danger"></span>
        <small class="text-body-secondary ms-auto"><span id="review-text-count">@Model.Text.Length</span> / 1000</small>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <button type="submit" name="submit" value="draft" class="btn btn-glass">
        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save draft
    </button>
    <button type="submit" name="submit" value="publish" class="btn btn-primary"
            onclick="return confirm('Publish this review? Once published it can no longer be edited or deleted.');">
        <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>Publish
    </button>
    <a asp-action="Index" class="btn btn-link text-body-secondary">Cancel</a>
</div>

<script>
    (() => {
        const text = document.getElementById('review-text');
        const count = document.getElementById('review-text-count');
        text.addEventListener('input', () => { count.textContent = text.value.length; });
    })();
</script>
