@model MoviesAdmin.ViewModels.Reviews.ReviewFormViewModel

@* Shared Create/Edit fields. Two submit buttons: "Save draft" keeps the review editable,
   "Publish" (name="submit" value="publish") locks it for good, so it asks for confirmation.
   The star picker and the rich-text editor are wired up by wwwroot/js/reviews.js; each writes
   into a hidden input (Rating, Text) that is what actually posts. *@

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="MovieId" class="form-label"></label>
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="MovieId" />
        <p class="form-control-plaintext fw-semibold">@Model.MovieTitle</p>
    }
    else
    {
        <select asp-for="MovieId" asp-items="ViewBag.MovieId" class="form-select">
            <option value="">Choose a movie...</option>
        </select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    }
</div>

<div class="mb-3">
    <label class="form-label" id="rating-label">Rating (out of 5)</label>
    <div class="d-flex flex-wrap align-items-center gap-3">
        @* Click the left or right half of a star for a half or full star; arrow keys move by half a star. *@
        <div class="star-picker" role="slider" tabindex="0" aria-labelledby="rating-label"
             aria-valuemin="0" aria-valuemax="5" aria-valuenow="@(Model.Rating?.ToString("0.#") ?? "")">
            @for (var star = 1; star <= 5; star++)
            {
                <i class="fa-solid fa-star star-empty" data-star="@star" aria-hidden="true"></i>
            }
        </div>
        <span class="star-picker-value fw-semibold" aria-live="polite"></span>
        <button type="button" class="btn btn-link btn-sm p-0 star-picker-zero">Give 0 stars</button>
    </div>
    <input type="hidden" asp-for="Rating" />
    <span asp-validation-for="Rating" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label" id="text-label">Review</label>
    <div class="review-editor">
        <div id="review-editor" aria-labelledby="text-label"></div>
    </div>
    <input type="hidden" asp-for="Text" />
    <div class="d-flex justify-content-between mt-1">
        <span asp-validation-for="Text" class="text-danger"></span>
        <small class="text-body-secondary ms-auto"><span id="review-text-count">0</span> / @MoviesAdmin.Services.ReviewText.ReviewHtml.MaxTextLength</small>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <button type="submit" name="submit" value="draft" class="btn btn-glass">
        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save draft
    </button>
    <button type="submit" name="submit" value="publish" class="btn btn-primary"
            onclick="return confirm('Publish this review? Once published it can no longer be edited or deleted.');">
        <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>Publish
    </button>
    <a asp-action="Index" class="btn btn-link text-body-secondary">Cancel</a>
</div>
