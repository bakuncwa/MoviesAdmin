@model MoviesAdmin.Models.Genre

@{
    ViewData["Title"] = "Genre Details";
}

<h1>Genre Details</h1>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>

    <h5 class="mt-4">Movies with this genre</h5>
    @if (Model.Movies.Count == 0)
    {
        <p class="text-body-secondary">No movies yet.</p>
    }
    else
    {
        <ul>
            @foreach (var movie in Model.Movies.OrderBy(m => m.Title))
            {
                <li>@movie.Title (@movie.ReleaseDate.Year)</li>
            }
        </ul>
    }
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
