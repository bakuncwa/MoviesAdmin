@* <div class="text-center">
    <h1 class="display-4">Movies Administration</h1>
    <p>Movies Administration Management Portal.</p>
</div> *@

<div class="text-center">
    @name. @message
</div>

<div class="text-center">
    @if(count > 5){
        <p>Count is greater than 5</p>
    }
    else{
        <p>Count is 5 or less</p>
    }
</div>

<div class="text-center">
    @foreach(string item in model){
        // If item == "Movie 3", format to bold when iterating through if-statement
        if(item == "Movie 3"){
            <ul><li><strong>@item</strong></li></ul>
        }
        else{
            <ul><li>@item</li></ul>
        }
    }
</div>

<div class="text-center">
    @foreach(modelMovie movie in modelMovie){
        if(movie.Title == "Movie 3"){
            <ul><li><strong>"@movie.Title"</strong> + "@movie.Synopsis"</li></ul>
        }
        else
        {
            <ul><li>"@movie.Title" + "@movie.Synopsis"</li></ul>
        }
    }
</div> 

<div><img src="~/wwwroot/img/prideprejudice.jpg" alt="Pride and Prejudice (2005)" class="img" /></div>