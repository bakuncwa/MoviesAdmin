@{
    ViewData["Title"] = "Home";
    var isAdmin = User.IsInRole(Roles.Administrator);
    var isCritic = User.IsInRole(Roles.Critic);
    // A critic (who isn't also an administrator) gets the critic-facing hero; everyone else the admin one.
    var criticPortal = isCritic && !isAdmin;
}

@* The only page open to signed-out visitors (see HomeController); every other page requires login. *@
<section class="hero hero-landing">
    <div class="hero-inner">
        <div class="hero-content">
            @if (criticPortal)
            {
                <span class="hero-eyebrow"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i>Critic portal</span>
                <h1 class="hero-title">Reelbox<span class="brand-accent">Critic</span></h1>
                <p class="hero-synopsis">Your screening room at Reelbox.</p>
            }
            else
            {
                <span class="hero-eyebrow"><i class="fa-solid fa-clapperboard" aria-hidden="true"></i>Management portal</span>
                <h1 class="hero-title">Reelbox<span class="brand-accent">Admin</span></h1>
                <p class="hero-synopsis">The projection booth behind Reelbox.</p>
            }
            <div class="hero-actions">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Log in</a>
                }
                else
                {
                    if (isAdmin)
                    {
                        <a class="btn btn-primary btn-lg" asp-controller="Movies" asp-action="Index"><i class="fa-solid fa-film me-2" aria-hidden="true"></i>Manage movies</a>
                    }
                    if (isCritic)
                    {
                        <a class="btn btn-primary btn-lg" asp-controller="Movies" asp-action="Index"><i class="fa-solid fa-film me-2" aria-hidden="true"></i>Browse movies</a>
                        <a class="btn btn-glass btn-lg" asp-controller="Reviews" asp-action="Index"><i class="fa-solid fa-pen-nib me-2" aria-hidden="true"></i>My reviews</a>
                    }
                    if (!isAdmin && !isCritic)
                    {
                        <span class="text-body-secondary">You're signed in, but your account hasn't been given a role yet. Ask an administrator to assign you the administrator or critic role in Auth0.</span>
                    }
                }
            </div>
        </div>
    </div>
</section>
