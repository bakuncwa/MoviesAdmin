@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
}

<section class="hero hero-landing">
    <div class="hero-inner">
        <div class="hero-content">
            <span class="hero-eyebrow"><i class="fa-solid fa-clapperboard" aria-hidden="true"></i>Management portal</span>
            <h1 class="hero-title">Movies Administration</h1>
            <p class="hero-synopsis">Curate the catalog: posters, trailers, directors, studios, and genres, all in one place.</p>
            <div class="hero-actions">
                @if (isAdmin)
                {
                    <a class="btn btn-primary btn-lg" asp-controller="Movies" asp-action="Index"><i class="fa-solid fa-film me-2" aria-hidden="true"></i>Manage movies</a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Log in</a>
                }
                else
                {
                    <span class="text-body-secondary">Your account has read-only access.</span>
                }
            </div>
        </div>
    </div>
</section>
